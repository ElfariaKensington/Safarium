<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Required for loading Chromium Embedded Framework / custom Chromium framework and Widevine CDM -->
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
	<!-- Required by V8 JIT and Blink WebAssembly compilation in renderer processes -->
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<key>com.apple.security.cs.allow-unsigned-executable-memory</key>
	<true/>
	<!-- Required for Chromium multi-process sandbox & helper execution -->
	<key>com.apple.security.cs.allow-dyld-environment-variables</key>
	<true/>
	<!-- Network client & camera/microphone/downloads access for a real browser -->
	<key>com.apple.security.network.client</key>
	<true/>
	<key>com.apple.security.files.downloads.read-write</key>
	<true/>
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<key>com.apple.security.device.camera</key>
	<true/>
</dict>
</plist>
